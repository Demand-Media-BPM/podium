{
  "Rules": [
    {
      "ID": "expire-submitted-videos-after-60-days",
      "Status": "Enabled",
      "Filter": { "Prefix": "responses/" },
      "Expiration": { "Days": 60 },
      "AbortIncompleteMultipartUpload": { "DaysAfterInitiation": 1 }
    },
    {
      "ID": "expire-unfinished-uploads-after-1-day",
      "Status": "Enabled",
      "Filter": { "Prefix": "pending/" },
      "Expiration": { "Days": 1 },
      "AbortIncompleteMultipartUpload": { "DaysAfterInitiation": 1 }
    }
  ]
}
