PORT=5000
FRONTEND_URL=http://localhost:5173
# Optional. Base URL used to build the shareable client links (https://<base>/respond/<token>).
# Defaults to FRONTEND_URL. Set it if clients should use a different public address.
PUBLIC_BASE_URL=
# MongoDB Atlas connection string (the database name is set in code: video_response_tool)
MONGODB_URI=
# Min. 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
NODE_ENV=development
# --- Video storage -------------------------------------------------------------------------------------------
# "s3" (default; the only option allowed when NODE_ENV=production) or "local" (DEVELOPMENT ONLY: videos are written
# to UPLOAD_DIR on this machine).
STORAGE_PROVIDER=s3

# AWS S3 (required when STORAGE_PROVIDER=s3). The bucket must be private. See docs/aws-s3-setup.md.
AWS_REGION=
AWS_S3_BUCKET=
# Credentials: leave BOTH empty to use the standard AWS credential chain - a local AWS profile (AWS_PROFILE) on your
# laptop, and the IAM instance role on EC2 (recommended for production: no long-term keys on the server).
# Only for local development without a profile. Never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Runs the 60-day expiry job inside the server every 6 hours. Set to "off" to run "npm run retention" from cron instead.
RETENTION_JOB=on

# Only when STORAGE_PROVIDER=local: development-only folder for uploaded videos (relative to backend/ or absolute).
UPLOAD_DIR=
