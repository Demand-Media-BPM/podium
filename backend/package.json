{
  "name": "video-response-tool-backend",
  "version": "1.0.0",
  "description": "Express API for the Video Response Tool",
  "main": "server.js",
  "private": true,
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "create-admin": "node scripts/createAdmin.js",
    "retention": "node scripts/runRetention.js",
    "list-local-videos": "node scripts/migrateLocalVideos.js",
    "migrate-local-videos": "node scripts/migrateLocalVideos.js --apply",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/*.test.js\"",
    "test:integration:local": "node scripts/testIntegrationLocal.js"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-presigned-post": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "archiver": "^8.0.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14"
  }
}
